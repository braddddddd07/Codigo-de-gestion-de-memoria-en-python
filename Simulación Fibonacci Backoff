import time
import random

def fibonacci_sequence():
    """Generador infinito de la secuencia de Fibonacci."""
    a, b = 1, 1
    while True:
        yield a
        a, b = b, a + b

def simular_peticion_api():
    """Simula una llamada de red con alta probabilidad de fallo temporal."""
    if random.random() < 0.75:  # 75% de probabilidad de fallar
        raise ConnectionError("503 Service Unavailable: El servidor está sobrecargado")
    return {"status": 200, "data": "Petición procesada correctamente"}

def conectar_con_fibonacci_backoff(max_intentos=6):
    fib_gen = fibonacci_sequence()
    
    for intento in range(1, max_intentos + 1):
        try:
            print(f"[Intento {intento}/{max_intentos}] Realizando petición a la API...")
            respuesta = simular_peticion_api()
            print(f"-> Conexión exitosa: {respuesta['data']}\n")
            return respuesta
            
        except ConnectionError as error:
            tiempo_espera = next(fib_gen)
            print(f"   Falló ({error}).")
            
            if intento < max_intentos:
                print(f"   Pausando durante {tiempo_espera} segundo(s) antes del próximo reintento...\n")
                time.sleep(tiempo_espera)
            else:
                print("\nSe alcanzó el límite máximo de reintentos. Cancelando operación.")
                return None

if __name__ == "__main__":
    conectar_con_fibonacci_backoff()
